{:paths ["src/clj"]
 :deps  {org.clojure/clojure        {:mvn/version "1.12.6"}
         dk.ative/docjure           {:mvn/version "1.22.0"}
         org.odftoolkit/odfdom-java {:mvn/version "0.13.0"}}
 :aliases
 {;; clojure -T:build javac   (needed once before :run or :test, compiles src/java)
  ;; clojure -M:run           (start the GUI)
  :run   {:extra-paths ["target/classes"]
          :main-opts   ["-m" "horizontal-maker.start"]}
  ;; clojure -M:test
  :test  {:extra-paths ["tests" "target/classes"]
          :extra-deps  {io.github.cognitect-labs/test-runner
                        {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
          :main-opts   ["-m" "cognitect.test-runner" "-d" "tests"]}
  ;; clojure -T:build uber   (builds target/horizontal-maker.jar)
  :build {:deps       {io.github.clojure/tools.build {:mvn/version "0.10.14"}}
          :ns-default build}}}
